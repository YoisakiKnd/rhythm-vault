{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"packages/**/*.ts",
			"apps/**/*.ts",
			"apps/**/*.svelte",
			"!**/node_modules",
			"!**/packages/data",
			"!**/.svelte-kit",
			"!**/build",
			"!**/.cache",
			"!**/drizzle/meta"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noParameterAssign": "off"
			},
			"complexity": {
				"noForEach": "off"
			}
		}
	}
}
