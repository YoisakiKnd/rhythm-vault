# ==== 必填 ====
# PostgreSQL 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rhythm_vault

# 第三方 OAuth 令牌的静态加密密钥（≥16 字符随机文本；空值与 changeme / ENCRYPTION_KEY / REPLACE_ME_… 等占位词会被拒绝；更换后已绑定的令牌将无法解密）
ENCRYPTION_KEY=

# ==== OAuth 应用（在对应开发者平台创建后填写）====
# 水鱼: https://auth.diving-fish.com/console
# redirect_uri 示例: http://localhost:5173/api/links/divingfish/callback
DIVING_FISH_CLIENT_ID=
DIVING_FISH_CLIENT_SECRET=
DIVING_FISH_REDIRECT_URI=

# 落雪: https://maimai.lxns.net/developer
# redirect_uri 示例: http://localhost:5173/api/links/lxns/callback
LXNS_CLIENT_ID=
LXNS_CLIENT_SECRET=
LXNS_REDIRECT_URI=
# 开发者 Token（可选）：绑定好友码后自动/手动同步可拉公开 b50/b30（玩家需在落雪开放第三方查询）
LXNS_DEVELOPER_TOKEN=

# ==== 可选 ====
# 站点对外地址（生产环境必填，用于 OAuth 回调）
BASE_URL=http://localhost:5173

# 数据库连接池与 SSL（托管库通常需要 DATABASE_SSL=true）
# DATABASE_POOL_MAX=5
# DATABASE_SSL=true

# Cloudflare Turnstile（可选）：配齐后登录/注册必须过人机验证
# 控制台创建小组件：https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# 站长用户名（逗号分隔）。可审批开发者申请（Bot Key）、手动确认 QQ 归属
# RV_ADMIN_USERS=your_username

# 本地开发：允许未验证 QQ 被 ?qq= 查询（生产不要开）
# RV_ALLOW_UNVERIFIED_QQ=1

# 生产（Caddy 反代）由 docker-compose.prod.yml 写入，不要自己读 X-Forwarded-For 首段：
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
# ORIGIN=https://你的域名
