# 生产环境模板。复制为服务器上的 .env，不要提交。
# 用法：
#   docker compose -f docker-compose.prod.yml --env-file .env pull
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# ENCRYPTION_KEY 上线前定好就不要再换——更换后已绑定的 OAuth 令牌全部解不开。
# 建议生产使用独立的一套 OAuth / Turnstile 凭据，回调地址与 BASE_URL 逐字符一致。

# GitHub 用户名或 org（小写），对应 ghcr.io/<GHCR_OWNER>/rhythm-vault-web
GHCR_OWNER=
IMAGE_TAG=latest

# Caddy 站点名，不要带 https://
RV_DOMAIN=example.com

# 站点对外地址（OAuth 回调 + adapter-node ORIGIN 都用它；不要末尾斜杠）
BASE_URL=https://example.com

# Postgres（compose 会用它拼容器内 DATABASE_URL；密码避免 @ / : 等 URL 特殊字符）
POSTGRES_PASSWORD=

# 第三方 OAuth 令牌的静态加密密钥（≥16 字符随机文本；占位词会被拒绝）
ENCRYPTION_KEY=

# 站长用户名（逗号分隔）。可签发 bot scope Key、手动确认 QQ 归属
RV_ADMIN_USERS=

# ==== OAuth 应用（生产回调必须先在开发者后台登记）====
# 水鱼: https://auth.diving-fish.com/console
DIVING_FISH_CLIENT_ID=
DIVING_FISH_CLIENT_SECRET=
DIVING_FISH_REDIRECT_URI=https://example.com/api/links/divingfish/callback

# 落雪: https://maimai.lxns.net/developer
LXNS_CLIENT_ID=
LXNS_CLIENT_SECRET=
LXNS_REDIRECT_URI=https://example.com/api/links/lxns/callback
# LXNS_DEVELOPER_TOKEN=

# Cloudflare Turnstile（推荐）：配齐后登录/注册必须过人机验证
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# 生产由 compose 写入，无需手填：
# ORIGIN=$BASE_URL
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
# RV_COVER_DIR=/app/.cache/covers
# DATABASE_POOL_MAX=10（web）/ 5（worker）

# 生产禁止打开：允许未验证 QQ 被 ?qq= 查询
# RV_ALLOW_UNVERIFIED_QQ=1
